# Copy this file to .bikes.env (not committed) and fill in real values.
# All variables are read by berlinbikes.config.Settings.from_env.

# Required: directory where the collector writes append-only daily Parquet files.
BIKES_DATA_DIR=./bikes-data

# Optional: directory where the nightly site build writes static output.
BIKES_SITE_DIR=./site-out

# Required: a descriptive User-Agent sent with every HTTP request.
BIKES_USER_AGENT=berlin-bike-data/0.1 (+https://github.com/tpatzelt/berlin-bike-data)

# Optional: nextbike Berlin GBFS 2.3 feed root.
BIKES_NEXTBIKE_GBFS_URL=https://gbfs.nextbike.net/maps/gbfs/v2/nextbike_bn/gbfs.json

# Optional: enable the Dott Berlin source (off by default).
BIKES_DOTT_ENABLED=false

# Optional: Dott Berlin GBFS feed root.
BIKES_DOTT_GBFS_URL=https://gbfs.api.ridedott.com/public/v2/berlin/gbfs.json
